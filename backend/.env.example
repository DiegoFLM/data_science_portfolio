# Backend Environment Variables
# Copy this file to .env and update with your values

# CORS Origins (comma-separated list of allowed origins)
# For local development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For production (update with your actual frontend URL)
# CORS_ORIGINS=https://your-portfolio.vercel.app,http://localhost:3000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Add these if you plan to use them later
# DATABASE_URL=postgresql://user:password@localhost/portfolio
# SECRET_KEY=your-secret-key-here
# ENVIRONMENT=development
